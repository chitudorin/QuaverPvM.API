# ================================
# Database (Aiven MySQL)
# ================================
# Get free MySQL at: https://aiven.io/free-mysql-database
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://avnadmin:your-password@mysql-xxx.aivencloud.com:12345/defaultdb"

# ================================
# Redis (Upstash)
# ================================
# Get free Redis at: https://upstash.com
# Format: redis://:PASSWORD@HOST:PORT
REDIS_URL="redis://:your-password@us1-xxx.upstash.io:12345"

# ================================
# Server Configuration
# ================================
PORT=5001
JWT_SECRET="your-super-secret-key-change-this-in-production"

# ================================
# Glicko Rating System
# ================================
GLICKO_TAU=0.6

# ================================
# Quaver Integration
# ================================
QUAVER_BASE_URL="https://quavergame.com"
API_BASE_URL="https://api.quavergame.com"

# ================================
# URLs (update for production)
# ================================
SELF_URL="http://localhost:5001"
CLIENT_BASE_URL="http://localhost:8080"

# ================================
# Quaver OAuth
# ================================
# Get credentials at: https://quavergame.com/settings/developer
# Redirect URI: http://localhost:5001/auth/quaver/callback
QUAVER_OAUTH_CLIENT="your-client-id"
QUAVER_OAUTH_SECRET="your-client-secret"
